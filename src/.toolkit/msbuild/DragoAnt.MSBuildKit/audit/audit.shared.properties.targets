<Project InitialTargets="SharedPropertiesProjectAudit">
  <!--  Validates the csproj-declared TF/TFs and TreatWarningsAsErrors against the shared
        config, reading the MSKit_TargetFramework[s]_Shared / _Proj snapshot that Core's
        tfm.routine.props captures at props phase.

        A literal duplicate of the shared value is a non-bypassable error (SHARED006/007); a
        DIFFERENT override is a bypassable warning (SHARED008/009); declaring both TF and TFs
        in one csproj is an error (SHARED010); and a switch between the two shapes is handled
        by Core's cleanup, not audited here. -->

  <Target Name="SharedPropertiesProjectAudit" BeforeTargets="Restore;CoreCompile">

    <PropertyGroup>
      <_MSKit_GuardXmlPeek Condition="'$(MSKit_GuardXmlPeekAudit)'!='False'">True</_MSKit_GuardXmlPeek>
      <_MSKit_SPC_CsprojText Condition="'$(_MSKit_GuardXmlPeek)'=='True'">$([System.IO.File]::ReadAllText('$(MSBuildProjectFullPath)'))</_MSKit_SPC_CsprojText>
      <_MSKit_HasTargetFramework Condition="'$(_MSKit_GuardXmlPeek)'!='True'">True</_MSKit_HasTargetFramework>
      <_MSKit_HasTargetFramework Condition="'$(_MSKit_GuardXmlPeek)'=='True' AND ($(_MSKit_SPC_CsprojText.Contains('&lt;TargetFramework&gt;')) OR $(_MSKit_SPC_CsprojText.Contains('&lt;TargetFramework ')))">True</_MSKit_HasTargetFramework>
      <_MSKit_HasTargetFrameworks Condition="'$(_MSKit_GuardXmlPeek)'!='True'">True</_MSKit_HasTargetFrameworks>
      <_MSKit_HasTargetFrameworks Condition="'$(_MSKit_GuardXmlPeek)'=='True' AND ($(_MSKit_SPC_CsprojText.Contains('&lt;TargetFrameworks&gt;')) OR $(_MSKit_SPC_CsprojText.Contains('&lt;TargetFrameworks ')))">True</_MSKit_HasTargetFrameworks>
    </PropertyGroup>

    <XmlPeek Condition="'$(_MSKit_HasTargetFramework)'=='True'" XmlInputPath="$(MSBuildProjectFullPath)" Query="Project/PropertyGroup/TargetFramework">
      <Output TaskParameter="Result" ItemName="_MSKit_TF_NodeCheckXmlResult" />
    </XmlPeek>
    <XmlPeek Condition="'$(_MSKit_HasTargetFrameworks)'=='True'" XmlInputPath="$(MSBuildProjectFullPath)" Query="Project/PropertyGroup/TargetFrameworks">
      <Output TaskParameter="Result" ItemName="_MSKit_TFs_NodeCheckXmlResult" />
    </XmlPeek>
    <PropertyGroup>
      <_MSKit_TF_ProjNodeCount>@(_MSKit_TF_NodeCheckXmlResult-&gt;Count())</_MSKit_TF_ProjNodeCount>
      <_MSKit_TFs_ProjNodeCount>@(_MSKit_TFs_NodeCheckXmlResult-&gt;Count())</_MSKit_TFs_ProjNodeCount>
    </PropertyGroup>

    <!-- MSKIT_SHARED006: csproj <TargetFramework> declares the SAME value as the shared config.
         Pure literal duplicate; not bypassable. Reads MSKit_TargetFramework_Proj (set by Core
         tfm.routine.props at props phase). -->
    <Error Code="MSKIT_SHARED006"
           Condition="'$(MSKit_TargetFramework_Proj)'!=''
                      AND '$(MSKit_TargetFramework_Shared)'!=''
                      AND '$(MSKit_TargetFramework_Proj)'=='$(MSKit_TargetFramework_Shared)'"
           File="$(MSBuildProjectFullPath)"
           Text="csproj '$(MSBuildProjectName)' declares &lt;TargetFramework&gt;$(MSKit_TargetFramework_Proj)&lt;/TargetFramework&gt; which equals Directory.Build.props's &lt;TargetFramework&gt;$(MSKit_TargetFramework_Shared)&lt;/TargetFramework&gt; - the csproj declaration is redundant.%0AFix: remove this from the csproj &lt;PropertyGroup&gt;:%0A  &lt;TargetFramework&gt;$(MSKit_TargetFramework_Proj)&lt;/TargetFramework&gt;%0ADirectory.Build.props is the single source of truth.%0AThis check is not bypassable; pure literal duplication is always a code smell." />

    <!-- MSKIT_SHARED007: csproj <TargetFrameworks> declares the SAME value as the shared config.
         Pure literal duplicate; not bypassable. -->
    <Error Code="MSKIT_SHARED007"
           Condition="'$(MSKit_TargetFrameworks_Proj)'!=''
                      AND '$(MSKit_TargetFrameworks_Shared)'!=''
                      AND '$(MSKit_TargetFrameworks_Proj)'=='$(MSKit_TargetFrameworks_Shared)'"
           File="$(MSBuildProjectFullPath)"
           Text="csproj '$(MSBuildProjectName)' declares &lt;TargetFrameworks&gt;$(MSKit_TargetFrameworks_Proj)&lt;/TargetFrameworks&gt; which equals Directory.Build.props's &lt;TargetFrameworks&gt;$(MSKit_TargetFrameworks_Shared)&lt;/TargetFrameworks&gt; - the csproj declaration is redundant.%0AFix: remove this from the csproj &lt;PropertyGroup&gt;:%0A  &lt;TargetFrameworks&gt;$(MSKit_TargetFrameworks_Proj)&lt;/TargetFrameworks&gt;%0ADirectory.Build.props is the single source of truth.%0AThis check is not bypassable; pure literal duplication is always a code smell." />

    <!-- MSKIT_SHARED008: csproj <TargetFramework> overrides DBP's <TargetFramework> with a different value.
         Warning by default; bypass with MSKit_SkipAudit_TargetFrameworkOverride=True.
         Does not fire when the csproj switches shape. -->
    <Warning Code="MSKIT_SHARED008"
             Condition="'$(MSKit_SkipAudit_TargetFrameworkOverride)'!='True'
                        AND '$(MSKit_TargetFramework_Proj)'!=''
                        AND '$(MSKit_TargetFramework_Shared)'!=''
                        AND '$(MSKit_TargetFramework_Proj)'!='$(MSKit_TargetFramework_Shared)'
                        AND '$(MSKit_TargetFrameworks_Proj)'==''"
             File="$(MSBuildProjectFullPath)"
             Text="csproj '$(MSBuildProjectName)' declares &lt;TargetFramework&gt;$(MSKit_TargetFramework_Proj)&lt;/TargetFramework&gt; but Directory.Build.props centralizes &lt;TargetFramework&gt;$(MSKit_TargetFramework_Shared)&lt;/TargetFramework&gt; as the default.%0ARecommended: remove the csproj-level &lt;TargetFramework&gt; declaration (DBP is the single source of truth).%0ATo override intentionally, add to the csproj &lt;PropertyGroup&gt;:%0A  &lt;MSKit_SkipAudit_TargetFrameworkOverride&gt;True&lt;/MSKit_SkipAudit_TargetFrameworkOverride&gt;" />

    <!-- MSKIT_SHARED009: csproj <TargetFrameworks> overrides DBP's <TargetFrameworks> with a different value.
         Warning by default; bypass with MSKit_SkipAudit_TargetFrameworkOverride=True.
         Does not fire when the csproj switches shape. -->
    <Warning Code="MSKIT_SHARED009"
             Condition="'$(MSKit_SkipAudit_TargetFrameworkOverride)'!='True'
                        AND '$(MSKit_TargetFrameworks_Proj)'!=''
                        AND '$(MSKit_TargetFrameworks_Shared)'!=''
                        AND '$(MSKit_TargetFrameworks_Proj)'!='$(MSKit_TargetFrameworks_Shared)'
                        AND '$(MSKit_TargetFramework_Proj)'==''"
             File="$(MSBuildProjectFullPath)"
             Text="csproj '$(MSBuildProjectName)' declares &lt;TargetFrameworks&gt;$(MSKit_TargetFrameworks_Proj)&lt;/TargetFrameworks&gt; but Directory.Build.props centralizes &lt;TargetFrameworks&gt;$(MSKit_TargetFrameworks_Shared)&lt;/TargetFrameworks&gt; as the default.%0ARecommended: remove the csproj-level &lt;TargetFrameworks&gt; declaration (DBP is the single source of truth).%0ATo override intentionally, add to the csproj &lt;PropertyGroup&gt;:%0A  &lt;MSKit_SkipAudit_TargetFrameworkOverride&gt;True&lt;/MSKit_SkipAudit_TargetFrameworkOverride&gt;" />

    <!-- MSKIT_SHARED010: csproj declares BOTH <TargetFramework> AND <TargetFrameworks>.
         Error, non-bypassable. SDK silently ignores <TargetFramework>
         when <TargetFrameworks> is non-empty (cross-targeting wins); the redundant declaration
         is a code smell that should be fixed at source. Uses NODE-presence count (not value)
         so even the legacy <TargetFramework></TargetFramework> "clear" trick fires the audit. -->
    <Error Code="MSKIT_SHARED010"
           Condition="$(_MSKit_TF_ProjNodeCount) &gt; 0 AND $(_MSKit_TFs_ProjNodeCount) &gt; 0"
           File="$(MSBuildProjectFullPath)"
           Text="csproj '$(MSBuildProjectName)' declares BOTH &lt;TargetFramework&gt; AND &lt;TargetFrameworks&gt; in the same project. SDK silently ignores &lt;TargetFramework&gt; when &lt;TargetFrameworks&gt; is non-empty.%0AFix: remove one of these from the csproj &lt;PropertyGroup&gt; - pick the shape you actually want:%0A  &lt;TargetFramework&gt;$(MSKit_TargetFramework_Proj)&lt;/TargetFramework&gt;%0A    -- OR --%0A  &lt;TargetFrameworks&gt;$(MSKit_TargetFrameworks_Proj)&lt;/TargetFrameworks&gt;%0AThis check is not bypassable; declaring both is always wrong." />

    <!-- TreatWarningsAsErrors - on CI, always skip: the pipeline controls it via -p:TreatWarningsAsErrors -->
    <PropertyGroup>
      <MSKit_SkipAudit_TreatWarningsAsErrors Condition="'$(MSKit_IsDevEnv)'!='True'">True</MSKit_SkipAudit_TreatWarningsAsErrors>
    </PropertyGroup>
    <Error Code="MSKIT_SHARED020"
           Condition="'$(MSKit_SkipAudit_TreatWarningsAsErrors)'!='True'
                      AND '$(MSKit_TreatWarningsAsErrors_Shared)'!=''
                      AND '$(TreatWarningsAsErrors)'!='$(MSKit_TreatWarningsAsErrors_Shared)'"
           File="$(MSBuildProjectFullPath)"
           Text="Expected &lt;TreatWarningsAsErrors&gt;$(MSKit_TreatWarningsAsErrors_Shared)&lt;/TreatWarningsAsErrors&gt; (from shared config / Directory.Build.props). Actual csproj-final value: '$(TreatWarningsAsErrors)'.%0AFix: align the csproj value with the shared one, or remove the csproj override.%0ATo bypass this audit, add to csproj or Directory.Build.props:%0A  &lt;PropertyGroup&gt;%0A    &lt;MSKit_SkipAudit_TreatWarningsAsErrors&gt;True&lt;/MSKit_SkipAudit_TreatWarningsAsErrors&gt;%0A  &lt;/PropertyGroup&gt;" />

  </Target>
</Project>
