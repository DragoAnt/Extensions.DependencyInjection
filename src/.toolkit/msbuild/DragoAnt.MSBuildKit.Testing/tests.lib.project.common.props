<Project>

  <!-- Explicit endpoint for a test helper library. Set MSKit_TestingFramework before the import
       (MSKIT_TEST020 checks it). -->
  <PropertyGroup>
    <_MSKit_TestingFrameworkAtLibCommonPropsImport>$(MSKit_TestingFramework)</_MSKit_TestingFrameworkAtLibCommonPropsImport>
    <_MSKit_TestsLibProjectCommonPropsImported>True</_MSKit_TestsLibProjectCommonPropsImported>
    <IsTestsLibProject>True</IsTestsLibProject>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)tests.project.props"
          Condition="'$(_MSKit_TestsProjectPropsImported)'!='True'" />

  <PropertyGroup Condition="'$(MSKit_TestingFramework_LibCommonPropsPath)'==''">
    <MSKit_TestingFramework_LibCommonPropsPath Condition="'$(MSKit_TestingFramework)'=='xunit.v3'">$(_MSKit_TestingFramework_xunit_v3_LibCommonPropsPath)</MSKit_TestingFramework_LibCommonPropsPath>
  </PropertyGroup>

  <Import Project="$(MSKit_TestingFramework_LibCommonPropsPath)"
          Condition="'$(MSKit_TestingFramework_LibCommonPropsPath)'!=''" />

</Project>
